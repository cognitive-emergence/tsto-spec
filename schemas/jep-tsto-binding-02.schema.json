{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cognitive-emergence/tsto-spec/main/schemas/jep-tsto-binding-02.schema.json",
  "title": "JEP-TSTO Binding/02",
  "description": "Supplementary JEP Core 0.7 / TSTO Binding/02 structural schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["jep", "id", "verb", "who", "when", "what", "sig", "ext"],
  "properties": {
    "jep": {"const": "1"},
    "id": {"type": "string", "minLength": 1},
    "verb": {"enum": ["J", "D", "T", "V"]},
    "who": {"type": "string", "minLength": 1},
    "when": {"type": "integer"},
    "what": {"type": ["object", "string"]},
    "aud": {"type": "string"},
    "ref": true,
    "ext": {
      "type": "object",
      "required": ["jep-tsto.binding"],
      "properties": {
        "jep-tsto.binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": {
              "const": "https://raw.githubusercontent.com/cognitive-emergence/tsto-spec/main/schemas/jep-tsto-binding-02.schema.json"
            }
          }
        }
      },
      "additionalProperties": {"type": "object"}
    },
    "ext_crit": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sig": {"type": ["string", "object"]}
  },
  "allOf": [
    {
      "if": {"properties": {"verb": {"const": "J"}}, "required": ["verb"]},
      "then": {
        "required": ["ref"],
        "properties": {
          "ref": {"$ref": "#/$defs/tstoEventRef"},
          "what": {"$ref": "#/$defs/judgment"}
        }
      }
    },
    {
      "if": {"properties": {"verb": {"const": "D"}}, "required": ["verb"]},
      "then": {
        "required": ["ref"],
        "properties": {
          "ref": {"$ref": "#/$defs/tstoEventRef"},
          "what": {"$ref": "#/$defs/delegation"}
        }
      }
    },
    {
      "if": {"properties": {"verb": {"const": "T"}}, "required": ["verb"]},
      "then": {
        "required": ["ref"],
        "properties": {
          "ref": {"$ref": "#/$defs/jepEventRef"},
          "what": {"$ref": "#/$defs/termination"}
        }
      }
    },
    {
      "if": {"properties": {"verb": {"const": "V"}}, "required": ["verb"]},
      "then": {
        "required": ["ref"],
        "properties": {
          "ref": {"$ref": "#/$defs/tstoEventRef"},
          "what": {"$ref": "#/$defs/verification"}
        }
      }
    }
  ],
  "$defs": {
    "tstoDigest": {"type": "string", "pattern": "^sha-256:[A-Za-z0-9_-]{43}$"},
    "jepArtifactHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "tstoRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "spec", "id", "digest"],
      "properties": {
        "kind": {"const": "external_object"},
        "type": {"const": "TargetStateTransition"},
        "spec": {"const": "TSTO/00"},
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/tstoDigest"}
      }
    },
    "tstoEventRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "TargetStateTransition"},
        "value": {"$ref": "#/$defs/tstoRef"}
      }
    },
    "eventIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["who", "id"],
      "properties": {
        "who": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "jepEventRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "jep:event"},
        "value": {"$ref": "#/$defs/eventIdentity"},
        "hash": {"$ref": "#/$defs/jepArtifactHash"}
      }
    },
    "immutableRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/tstoDigest"}
      }
    },
    "evidenceRef": {
      "type": "object",
      "required": ["id", "kind", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/tstoDigest"},
        "observed_at": {"type": "string", "format": "date-time"},
        "media_type": {"type": "string"},
        "location": {"type": "string"}
      }
    },
    "judgment": {
      "type": "object",
      "required": ["claim", "decision"],
      "properties": {
        "claim": {"const": "tsto_judgment"},
        "decision": {"enum": ["propose", "accept", "reject", "reassess"]},
        "reason": {"type": "string"},
        "context": {"type": "object"}
      }
    },
    "delegation": {
      "type": "object",
      "required": ["claim", "delegatee", "scope"],
      "properties": {
        "claim": {"const": "tsto_delegation"},
        "delegatee": {"type": "string", "minLength": 1},
        "scope": {"type": ["array", "object", "string"]},
        "constraints": {"type": ["array", "object"]},
        "expiry": {"type": "string"},
        "termination_conditions": {"type": "array"}
      }
    },
    "termination": {
      "type": "object",
      "required": ["claim", "termination_scope", "subject"],
      "properties": {
        "claim": {"const": "tsto_termination"},
        "termination_scope": {"type": ["string", "object", "array"]},
        "subject": {"$ref": "#/$defs/tstoRef"},
        "reason": {"type": "string"}
      }
    },
    "verification": {
      "type": "object",
      "required": ["claim", "verification_scope", "result", "policy_ref", "evidence"],
      "properties": {
        "claim": {"const": "tsto_verification"},
        "verification_scope": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "result": {"enum": ["SATISFIED", "NOT_SATISFIED", "INDETERMINATE"]},
        "policy_ref": {"$ref": "#/$defs/immutableRef"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceRef"}
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string"}
      }
    }
  }
}
