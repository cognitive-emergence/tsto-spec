{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cognitive-emergence/tsto-spec/main/schemas/jep-tsto-binding-02.schema.json",
  "title": "JEP-TSTO Binding/02 — supplementary structure",
  "$comment": "Apply together with the pinned JEP Core 0.7 schema. Signatures, reference resolution, identity conflicts and policy evaluation require separate checks.",
  "type": "object",
  "required": [
    "ref",
    "what",
    "ext"
  ],
  "properties": {
    "ext": {
      "type": "object",
      "required": [
        "jep-tsto.binding"
      ],
      "properties": {
        "jep-tsto.binding": {
          "type": "object",
          "required": [
            "version",
            "spec"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": "02"
            },
            "spec": {
              "const": "JEP-TSTO-Binding/02"
            }
          }
        },
        "prooftask.binding": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verb": {
            "const": "J"
          }
        },
        "required": [
          "verb"
        ]
      },
      "then": {
        "properties": {
          "ref": {
            "$ref": "#/$defs/tstoEventRef"
          },
          "what": {
            "$ref": "#/$defs/judgment"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "D"
          }
        },
        "required": [
          "verb"
        ]
      },
      "then": {
        "properties": {
          "ref": {
            "$ref": "#/$defs/tstoEventRef"
          },
          "what": {
            "$ref": "#/$defs/delegation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "T"
          }
        },
        "required": [
          "verb"
        ]
      },
      "then": {
        "properties": {
          "ref": {
            "$ref": "#/$defs/jepEventRef"
          },
          "what": {
            "$ref": "#/$defs/termination"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "V"
          }
        },
        "required": [
          "verb"
        ]
      },
      "then": {
        "properties": {
          "ref": {
            "$ref": "#/$defs/tstoEventRef"
          },
          "what": {
            "$ref": "#/$defs/verification"
          }
        }
      }
    }
  ],
  "$defs": {
    "tstoDigest": {
      "type": "string",
      "pattern": "^sha-256:[A-Za-z0-9_-]{43}$"
    },
    "tstoRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "type",
        "spec",
        "id",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "external_object"
        },
        "type": {
          "const": "TargetStateTransition"
        },
        "spec": {
          "const": "TSTO/00"
        },
        "id": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "$ref": "#/$defs/tstoDigest"
        }
      }
    },
    "immutableRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "$ref": "#/$defs/tstoDigest"
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "digest",
        "observed_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/tstoDigest"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "claim",
        "decision"
      ],
      "properties": {
        "claim": {
          "const": "tsto_judgment"
        },
        "decision": {
          "enum": [
            "propose",
            "accept",
            "reject",
            "reassess"
          ]
        },
        "reason": {
          "type": "string"
        },
        "context": {
          "type": "object"
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "claim",
        "delegatee",
        "scope"
      ],
      "properties": {
        "claim": {
          "const": "tsto_delegation"
        },
        "delegatee": {
          "type": "string",
          "minLength": 1
        },
        "scope": {}
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "claim",
        "subject",
        "termination_scope"
      ],
      "properties": {
        "claim": {
          "const": "tsto_termination"
        },
        "subject": {
          "$ref": "#/$defs/tstoRef"
        },
        "termination_scope": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "target": false
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "claim",
        "verification_scope",
        "result",
        "policy_ref",
        "evidence"
      ],
      "properties": {
        "claim": {
          "const": "tsto_verification"
        },
        "verification_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "result": {
          "enum": [
            "SATISFIED",
            "NOT_SATISFIED",
            "INDETERMINATE"
          ]
        },
        "policy_ref": {
          "$ref": "#/$defs/immutableRef"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "tstoEventRef": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tsto:target-state-transition"
        },
        "value": {
          "$ref": "#/$defs/tstoRef"
        }
      }
    },
    "jepEventRef": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "jep:event"
        },
        "value": {
          "type": "object",
          "required": [
            "who",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "who": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[\\x00-\\x7F]+$"
            }
          }
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
