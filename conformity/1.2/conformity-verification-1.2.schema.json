{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanjudgment.org/ns/conformity-verification/1.2",
  "type": "object",
  "properties": {
    "schema": {
      "const": "https://humanjudgment.org/ns/conformity-verification/1.2"
    },
    "status": {
      "enum": [
        "VERIFIED_WITH_LIMITATIONS",
        "INVALID",
        "PARTIAL_DISCLOSURE",
        "INDETERMINATE"
      ]
    },
    "closure": {
      "enum": [
        "COMPLETE",
        "NOT_COMPLETE",
        "NOT_ESTABLISHED"
      ]
    },
    "disclosures": {
      "type": "object",
      "properties": {
        "disclosed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "disclosed",
        "total"
      ],
      "additionalProperties": false
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "maxItems": 1000
    },
    "issuer": {
      "type": "string",
      "pattern": "^https://[^/?#]+$"
    },
    "ignoredFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commitments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tsto",
        "jepEvents",
        "attachmentManifest"
      ],
      "properties": {
        "tsto": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "mediaType",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "mediaType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "jepEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "mediaType",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "mediaType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "maxItems": 10000
        },
        "attachmentManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "mediaType",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "mediaType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "currentStatus": {
      "enum": [
        "NOT_CHECKED",
        "FRESH",
        "UNKNOWN"
      ]
    },
    "currentState": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 200
        }
      ]
    },
    "limitations": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "time",
        "bitcoin",
        "earliestIndependentTime"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alg",
            "digest"
          ],
          "properties": {
            "alg": {
              "const": "sha-256"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_PRESENT",
                "VERIFIED",
                "FAILED"
              ]
            },
            "genTime": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "tsa": {
              "type": "string",
              "maxLength": 200
            },
            "policy": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)+$"
            },
            "revocation": {
              "enum": [
                "CHECKED",
                "NOT_CHECKED"
              ]
            },
            "renewals": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "count"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "VERIFIED",
                    "FAILED"
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                "latestGenTime": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                }
              }
            }
          }
        },
        "bitcoin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_PRESENT",
                "PENDING",
                "VERIFIED",
                "FAILED"
              ]
            },
            "height": {
              "type": "integer",
              "minimum": 0
            },
            "blockHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "blockTime": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "confirmations": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "earliestIndependentTime": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            }
          ]
        },
        "signatures": {
          "description": "Trusted time for party-signature targets. Never part of the record's time, independent time or verdict. binding, role, stage, deadline and deadlineEvidence come from the issuer profile.",
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "digest",
              "time"
            ],
            "properties": {
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "time": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "VERIFIED",
                      "FAILED"
                    ]
                  },
                  "genTime": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  "latestTime": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                  },
                  "tsa": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "revocation": {
                    "enum": [
                      "CHECKED",
                      "NOT_CHECKED"
                    ]
                  },
                  "renewals": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "count"
                    ],
                    "properties": {
                      "status": {
                        "enum": [
                          "VERIFIED",
                          "FAILED"
                        ]
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 32
                      },
                      "latestGenTime": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                      }
                    }
                  }
                }
              },
              "binding": {
                "enum": [
                  "RECORD_HISTORY",
                  "VERIFIED_AGREEMENT_PROOF",
                  "ISSUER_ASSERTED",
                  "NOT_BOUND"
                ]
              },
              "role": {
                "enum": [
                  "BUYER",
                  "PROVIDER"
                ]
              },
              "stage": {
                "enum": [
                  "AGREEMENT",
                  "ACCEPTANCE"
                ]
              },
              "deadline": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              "deadlineEvidence": {
                "enum": [
                  "EXISTED_BY_SIGNING_DEADLINE",
                  "NOT_ESTABLISHED_BY_THIS_EVIDENCE"
                ]
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "status",
    "closure",
    "disclosures",
    "reasons"
  ],
  "additionalProperties": false
}
