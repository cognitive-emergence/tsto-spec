{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanjudgment.org/ns/conformity-anchors/1.0",
  "title": "Conformity Package anchoring evidence index (evidence/anchors.json, package standard 1.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "https://humanjudgment.org/ns/conformity-anchors/1.0"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "digest"
      ],
      "properties": {
        "alg": {
          "const": "sha-256",
          "description": "Digest algorithm of the anchored subject. Verifiers accept only the listed algorithms and report others as ANCHOR_EVIDENCE_INVALID."
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the ASCII issuer-signed JWT, the part of record.sd-jwt before the first '~'."
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "token"
            ],
            "properties": {
              "type": {
                "const": "rfc3161"
              },
              "token": {
                "type": "string",
                "maxLength": 199,
                "pattern": "^evidence/rfc3161/[a-z0-9/._-]+$"
              },
              "validation": {
                "type": "string",
                "maxLength": 199,
                "pattern": "^evidence/ltv/[a-z0-9/._-]+$"
              },
              "renewals": {
                "description": "Renewal tokens, oldest first. Each is an RFC 3161 token whose SHA-256 message imprint is SHA-256 of the previous token's DER bytes, with genTime no earlier than it.",
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "token"
                  ],
                  "properties": {
                    "token": {
                      "type": "string",
                      "maxLength": 199,
                      "pattern": "^evidence/rfc3161/[a-z0-9/._-]+$"
                    },
                    "validation": {
                      "type": "string",
                      "maxLength": 199,
                      "pattern": "^evidence/ltv/[a-z0-9/._-]+$"
                    }
                  }
                }
              },
              "target": {
                "description": "Present when the token stamps a party signature instead of the record: the SHA-256 of the signed original. The verifier checks the token against this digest; binding the digest to the record is the issuer profile's check.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "alg",
                  "digest"
                ],
                "properties": {
                  "kind": {
                    "const": "party-signature"
                  },
                  "alg": {
                    "const": "sha-256"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "proof"
            ],
            "properties": {
              "type": {
                "const": "opentimestamps"
              },
              "proof": {
                "type": "string",
                "maxLength": 199,
                "pattern": "^evidence/ots/[a-z0-9/._-]+$"
              },
              "headers": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "fromHeight"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 199,
                    "pattern": "^evidence/bitcoin/[a-z0-9/._-]+$"
                  },
                  "fromHeight": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        ]
      }
    },
    "omitted": {
      "description": "Number of evidence items the issuer holds but left out of this Package (size limits). Verifiers report ANCHOR_EVIDENCE_OMITTED.",
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  }
}
