{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanjudgment.org/ns/conformity-verification/1.0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "https://humanjudgment.org/ns/conformity-verification/1.0"
    },
    "status": {
      "enum": [
        "VERIFIED_WITH_LIMITATIONS",
        "INVALID",
        "PARTIAL_DISCLOSURE",
        "PRE_RELEASE_TEST_RECORD"
      ]
    },
    "closure": {
      "enum": [
        "COMPLETE",
        "NOT_COMPLETE",
        "NOT_ESTABLISHED"
      ]
    },
    "disclosures": {
      "type": "object",
      "properties": {
        "disclosed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "disclosed",
        "total"
      ],
      "additionalProperties": false
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "maxItems": 1000
    },
    "issuer": {
      "type": "string",
      "pattern": "^https://[^/?#]+$"
    },
    "ignoredFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commitments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tsto",
        "jepEvents",
        "attachmentManifest"
      ],
      "properties": {
        "tsto": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "mediaType",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "mediaType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "jepEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "mediaType",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "mediaType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "maxItems": 10000
        },
        "attachmentManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "mediaType",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "mediaType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "currentStatus": {
      "enum": [
        "NOT_CHECKED",
        "FRESH",
        "UNKNOWN"
      ]
    },
    "currentState": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 200
        }
      ]
    }
  },
  "required": [
    "schema",
    "status",
    "closure",
    "disclosures",
    "reasons"
  ],
  "additionalProperties": false
}
