      "id": "partial-with-jep",
      "action": "LEAK_JEP",
      "expectedError": "PARTIAL_PRESENTATION_LEAKS_COMMITTED_CONTENT"
    },
    {
      "id": "replace-jep-file",
      "action": "REPLACE_JEP",
      "expectedError": "PACKAGE_CONTENT_MISMATCH"
    },
    {
      "id": "delete-attachment",
      "action": "DELETE_ATTACHMENT",
      "expectedError": "PACKAGE_CONTENT_MISMATCH"
    },
    {
      "id": "uncommitted-extra-file",
      "action": "EXTRA_FILE",
      "expectedStatus": "VERIFIED_WITH_LIMITATIONS",
      "expectedReasons": [
        "ACTOR_ATTRIBUTION_RECORDER_ASSERTION",
        "UNCOMMITTED_FILE"
      ]
    },
    {
      "id": "same-signed-commitments",
      "action": "MATCH_COMMITMENTS"
    },
    {
      "id": "issuer-identifier-mismatch",
      "action": "ISSUER_MISMATCH",
      "expectedError": "ISSUER_IDENTIFIER_MISMATCH"
