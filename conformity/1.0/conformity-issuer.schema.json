{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanjudgment.org/ns/conformity-issuer/1.0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "https://humanjudgment.org/ns/conformity-issuer/1.0"
    },
    "issuer": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[a-z][a-z0-9+.-]*:"
    },
    "id": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[a-z][a-z0-9+.-]*:"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[a-z][a-z0-9+.-]*:"
          },
          "type": {
            "const": "Multikey"
          },
          "controller": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[a-z][a-z0-9+.-]*:"
          },
          "publicKeyMultibase": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^z6Mk[1-9A-HJ-NP-Za-km-z]+$"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "RETIRED",
              "REVOKED"
            ]
          },
          "validFrom": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
          },
          "validUntil": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
          }
        },
        "required": [
          "id",
          "type",
          "controller",
          "publicKeyMultibase",
          "status"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "required": [
    "schema",
    "issuer",
    "id",
    "keys"
  ],
  "additionalProperties": false
}
