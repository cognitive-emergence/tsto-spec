{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanjudgment.org/ns/conformity-package/1.0",
  "type": "object",
  "required": [
    "schema",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "https://humanjudgment.org/ns/conformity-package/1.0"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mediaType",
          "sha256",
          "encoding",
          "data"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "encoding": {
            "const": "base64url"
          },
          "data": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]*$",
            "maxLength": 22000000
          }
        }
      }
    }
  }
}
